    {
      "id": "bb98d61c-05da-4188-b608-246721159ee2",
      "name": "Prepare Rows for Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "jsCode": "const sheetData = $('Prepare Sheet Data').first().json;\nconst expenses = sheetData.expenses || [];\n\nreturn expenses.map(exp => ({\n  json: {\n    Date: exp.date,\n    Amount: exp.amount,\n    Description: exp.description,\n    Category: exp.category,\n    sheetName: exp.sheetName || sheetData.sheetName\n  }\n}));"
      }
    },
    {
      "id": "74434884-871c-40a3-a6c8-05788e56cf35",
      "name": "Format Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Prepare Sheet Data').first().json.chatId;\nconst sheetName = $('Prepare Sheet Data').first().json.sheetName;\n\nif (items.length === 1) {\n  const exp = items[0].json;\n  const text = `✅ *Expense Logged!*\n\n📅 Date: \\`${exp.Date}\\`\n💰 Amount: ₹${exp.Amount}\n📝 Description: ${exp.Description}\n🏷️ Category: ${exp.Category}\n📊 Sheet: _${sheetName}_`;\n\n  return [{ json: { text, chatId } }];\n}\n\nlet total = 0;\nconst list = items.map((item, idx) => {\n  const exp = item.json;\n  total += Number(exp.Amount) || 0;\n  return `${idx + 1}. *${exp.Description}* — ₹${exp.Amount} _(${exp.Category})_`;\n}).join('\\n');\n\nconst text = `✅ *${items.length} Expenses Logged!*\n\n${list}\n\n💰 *Total:* ₹${total}\n📊 *Sheet:* _${sheetName}_`;\n\nreturn [{ json: { text, chatId } }];"
      }
    }

    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "=Today's date: {{ $now.format('yyyy-MM-dd') }}\n\nExtract all expenses from the message into a JSON array:\n[\n  {\n    \"amount\": <number>,\n    \"date\": \"YYYY-MM-DD\",\n    \"description\": \"<short description, 1-4 words>\",\n    \"category\": \"<one of: Food & Drinks, Transport, Shopping, Housing, Health, Entertainment, Education, Travel, Personal Care, Finance, Other>\"\n  }\n]\n\nRules:\n- Supports multiple expenses (separated by newlines, commas, and, etc.) or single expense.\n- Handle k/K (2k = 2000, 1.5k = 1500).\n- Handle relative dates: yesterday, last monday, etc. Default to today.\n- Expand short names: swiggy/zomato -> Food Delivery, uber/ola -> Cab Ride, blinkit/zepto -> Grocery.\n- If no valid expense found, return [].\n- Return ONLY the raw JSON array. No explanations, no markdown fences."
        }
      },
      "id": "b9c55436-98dc-4241-b55e-69845b6056db",
      "name": "Extract Expense Data",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -528,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "check-is-valid",
              "leftValue": "={{ $json.isValid }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "id": "b8df182f-cc7b-4052-9eef-8c7c9d42f792",
      "name": "Is Valid Expense?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json.text || '';\nconst clean = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet expenses = [];\ntry {\n  const parsed = JSON.parse(clean);\n  if (Array.isArray(parsed)) {\n    expenses = parsed;\n  } else if (parsed && Array.isArray(parsed.expenses)) {\n    expenses = parsed.expenses;\n  } else if (parsed && typeof parsed === 'object') {\n    expenses = [parsed];\n  }\n} catch (e) {\n  expenses = [];\n}\n\nconst validExpenses = expenses.filter(e => typeof e.amount === 'number' && e.amount > 0);\n\nif (validExpenses.length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      chatId: $('Telegram Trigger').first().json.message.chat.id\n    }\n  }];\n}\n\nconst monthNames = [\n  'January', 'February', 'March', 'April', 'May', 'June',\n  'July', 'August', 'September', 'October', 'November', 'December'\n];\n\nconst primaryDate = new Date(validExpenses[0].date || new Date());\nconst sheetName = `${monthNames[primaryDate.getMonth()]} ${primaryDate.getFullYear()}`;\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nreturn [{\n  json: {\n    isValid: true,\n    sheetName: sheetName,\n    chatId: chatId,\n    expenses: validExpenses.map(e => {\n      const d = new Date(e.date || new Date());\n      const sName = `${monthNames[d.getMonth()]} ${d.getFullYear()}`;\n      return {\n        date: e.date || new Date().toISOString().slice(0, 10),\n        amount: e.amount,\n        description: e.description || 'Expense',\n        category: e.category || 'Other',\n        sheetName: sName\n      };\n    })\n  }\n}];"
      },
